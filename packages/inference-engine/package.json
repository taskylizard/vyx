{
  "name": "@packages/inference-engine",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "seed": "bun src/query-engine/seed.ts",
    "queryengine:eval": "infisical run --env=dev -- bun src/query-engine/evals.ts",
    "askai:eval": "infisical run --env=dev -- bun src/ask-ai-engine/evals.ts",
    "personality:eval": "infisical run --env=dev -- bun src/personality-engine/evals.ts",
    "aitasks:eval": "infisical run --env=dev -- bun src/ai-tasks/evals.ts",
    "imagegen:eval": "infisical run --env=dev -- bun src/image-generation/evals.ts"
  },
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "devDependencies": {
    "@packages/typescript-config": "workspace:*",
    "@types/bun": "catalog:types",
    "openapi-typescript": "catalog:tsc",
    "typescript": "catalog:tsc",
    "tsdown": "catalog:build"
  },
  "dependencies": {
    "@apps/bot": "workspace:^",
    "@llamaindex/google": "catalog:prod",
    "@llamaindex/huggingface": "catalog:prod",
    "@llamaindex/qdrant": "catalog:prod",
    "@llamaindex/readers": "catalog:prod",
    "@packages/database": "workspace:*",
    "@packages/env": "workspace:^",
    "@qdrant/js-client-rest": "catalog:prod",
    "fastembed": "catalog:prod",
    "llamaindex": "catalog:prod",
    "oceanic.js": "catalog:prod",
    "openapi-fetch": "catalog:network",
    "zod": "catalog:utils"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts"
}
