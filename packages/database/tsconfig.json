{
  "compilerOptions": {
    "strict": true,
    "esModuleInterop": true,
    "typeRoots": [
      "./node_modules/@types"
    ],
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": [
    "**/*.ts",
    "src/generated"
  ],
  "exclude": [
    "node_modules"
  ]
}
