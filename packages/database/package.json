{
  "name": "@packages/database",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./prisma": "./src/generated/index.js",
    "./prisma/*": "./src/generated/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "prisma": "prisma",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:format": "prisma format",
    "db:generate": "prisma generate && bun run build",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@packages/typescript-config": "workspace:*",
    "drizzle-orm": "catalog:database",
    "pg": "catalog:prod",
    "@prisma/adapter-pg": "catalog:database",
    "@prisma/client": "catalog:database",
    "prisma": "catalog:database"
  },
  "devDependencies": {
    "tsdown": "catalog:build",
    "@types/bun": "catalog:types",
    "drizzle-prisma-generator": "catalog:database",
    "typescript": "catalog:tsc",
    "@types/pg": "catalog:types"
  }
}
