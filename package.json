{
  "name": "@taskylizard/kanikou",
  "private": true,
  "scripts": {
    "test": "bun run --filter='*' test",
    "format": "dprint fmt",
    "lint": "oxlint",
    "build": "bun run --filter='@apps/dashboard' build",
    "dev": "bun run -F @apps/dashboard dev",
    "typecheck": "bun run --filter='*' typecheck",
    "db:generate": "bun run -F @packages/database db:generate",
    "start": "bun --filter=@apps/dashboard start",
    "bot:start": "bun run --filter=@apps/bot start",
    "bot:dev": "bun --elide-lines=100 run -F @apps/bot dev"
  },
  "devDependencies": {
    "oxlint-tsgolint": "catalog:lint",
    "oxlint": "catalog:lint",
    "tsdown": "catalog:build"
