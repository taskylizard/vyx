{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "prisma": {
      "type": "local",
      "command": ["bun", "x", "prisma", "mcp"],
      "enabled": true
    },
    "plane": {
      "type": "local",
      "command": ["bunx", "mcp-remote", "https://mcp.plane.so/sse"],
      "enabled": true
    },
    "gh_grep": {
      "type": "remote",
      "url": "https://mcp.grep.app"
    }
  }
}
